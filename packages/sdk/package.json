{
  "name": "@artblocks/abxfs-sdk",
  "version": "0.4.0",
  "description": "ABX FS SDK — content-addressed, immutable file storage on any EVM chain. Chunk, compute CIDs, upload, read, and derive IPFS CIDs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtBlocks/abxfs.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.fs.abx.io",
  "bugs": "https://github.com/ArtBlocks/abxfs/issues",
  "keywords": [
    "abxfs",
    "onchain-storage",
    "content-addressed",
    "ipfs",
    "cid",
    "unixfs",
    "fastcdc",
    "evm",
    "ethereum",
    "viem"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./content-host": {
      "types": "./dist/content-host.d.ts",
      "import": "./dist/content-host.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "import": "./dist/names.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "gen:battery": "node scripts/abx-battery.mjs"
  },
  "dependencies": {
    "@artblocks/abx-sdk": "0.7.0",
    "@ipld/dag-pb": "^4.2.0",
    "ipfs-unixfs": "^13.1.2",
    "multiformats": "^13.3.1",
    "viem": "^2.57.14"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "blockstore-core": "^7.0.1",
    "ipfs-unixfs-importer": "^17.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

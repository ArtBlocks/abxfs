{
  "name": "@artblocks/abxfs-cli",
  "version": "0.0.0",
  "private": true,
  "description": "ABX FS command-line interface \u2014 upload a folder to the blockchain and read it back.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtBlocks/abxfs.git"
  },
  "homepage": "https://github.com/ArtBlocks/abxfs#readme",
  "bugs": "https://github.com/ArtBlocks/abxfs/issues",
  "keywords": [
    "abxfs",
    "cli",
    "onchain-storage",
    "ipfs",
    "evm"
  ],
  "type": "module",
  "bin": {
    "abxfs": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "cli": "node --experimental-strip-types ./src/index.ts"
  },
  "dependencies": {
    "@artblocks/abxfs-sdk": "workspace:*",
    "@artblocks/abxfs-pinning": "workspace:*",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "viem": "^2.57.14"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

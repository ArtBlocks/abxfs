pragma solidity ^0.8.24;

import {BaseCompanionTest} from "./Base.t.sol";
import {IpfsCidResolver} from "../src/IpfsCidResolver.sol";
import {IpfsCidResolverHarness} from "./mocks/IpfsCidResolverHarness.sol";
import {CID} from "@abxfs/protobuf/CID.sol";
import {DagPB} from "@abxfs/protobuf/DagPB.sol";
import {UnixFS} from "@abxfs/protobuf/UnixFS.sol";

/// @notice Multi-level balanced DAGs: the fold against `ipfs-unixfs-importer` fixtures with distinct synthetic leaves
///         (`test/fixtures/multi-level-dag.json`, regenerated by `generate-multilevel-dag.mjs`), and one real file of
///         175 blocks streamed from chain end to end.
contract IpfsCidResolverMultiLevelTest is BaseCompanionTest {
    IpfsCidResolverHarness internal harness;
    IpfsCidResolver internal resolver;
    string internal fixtureJson;

    function setUp() public override {
        super.setUp();
        harness = new IpfsCidResolverHarness(address(fileStore), address(directoryStore));
        resolver = new IpfsCidResolver(address(fileStore), address(directoryStore));
        fixtureJson = vm.readFile("./test/fixtures/multi-level-dag.json");
    }

    function test_175Leaves_TwoLayerDag() public view {
        _run(0, "leaves-175", false);
    }

    function test_350Leaves_ThreeWideTwoLayer() public view {
        _run(1, "leaves-350", false);
    }

    function test_200Leaves_NonUniformSizes() public view {
        _run(2, "mixed-200", true);
    }

    /// 175 blocks (one more than a node holds) streamed from chain: blocks 0 and 1 of `runBytes`, alternating, each block
    /// stored once as 11 raw chunks (the file's 1,925 chunk records repeat them). Expected CID from the SDK's
    /// `ipfsFileCidWithSize`, matched by `ipfs-unixfs-importer`, over the same 45,875,200 bytes.
    function test_175Blocks_EndToEnd() public {
        bytes memory both = runBytes(2 * 262_144);
        bytes32[11][2] memory blockIds;
        uint256[11] memory blockSizes;
        for (uint256 b; b < 2; b++) {
            for (uint256 c; c < 11; c++) {
                uint256 len = c == 10 ? 262_144 - 10 * RAW_MAX : RAW_MAX;
                blockSizes[c] = len;
                blockIds[b][c] = rawChunk(slice(both, b * 262_144 + c * RAW_MAX, len));
            }
        }
        bytes32[] memory ids = new bytes32[](175 * 11);
        uint256[] memory sizes = new uint256[](175 * 11);
        for (uint256 i; i < 175; i++) {
            for (uint256 c; c < 11; c++) {
                ids[i * 11 + c] = blockIds[i % 2][c];
                sizes[i * 11 + c] = blockSizes[c];
            }
        }
        bytes32 cid = createFileFromChunks(ids, sizes, "application/octet-stream");
        uint256 g = gasleft();
        assertEq(resolver.computeFileCid(cid), EXPECTED_ALTERNATING_175);
        emit log_named_uint("gas: 175-block raw file (45,875,200 bytes, warm repeated chunks)", g - gasleft());
        (uint256 codec,, uint256 tsize) = resolver.fileLink(cid);
        assertEq(codec, 0x70);
        assertEq(tsize, EXPECTED_ALTERNATING_175_TSIZE);
    }

    /// The fold at the edges of a node's 174-link capacity: 2 leaves, one short of full, exactly full (one node, no
    /// second layer), one over (a second node holding a single link), two full nodes, and one over that. The expected
    /// nodes are encoded with `protobuf-sol` (`DagPB`, `UnixFS`, `CID`), which the resolver does not use; the grouping
    /// rule itself (consecutive groups of 174, a lone leftover still wrapped in a node) is the one the 175, 200 and
    /// 350-leaf importer fixtures above pin.
    function test_foldMatchesReferenceAtGroupEdges() public {
        uint16[6] memory counts = [2, 173, 174, 175, 348, 349];
        for (uint256 i; i < counts.length; i++) {
            // an external self-call: each size gets a fresh memory arena
            this.checkFold(counts[i]);
        }
    }

    function checkFold(uint256 n) external view {
        bytes32[] memory shas = new bytes32[](n);
        uint256[] memory sizes = new uint256[](n);
        for (uint256 i; i < n; i++) {
            shas[i] = keccak256(abi.encode("leaf", i));
            sizes[i] = 1 + (i * 7919 + 13) % 262_144; // varied sizes, one- to three-byte varints
        }
        (string memory gotCid, bytes32 gotSha, uint256 gotLen, uint256 gotCum) = harness.foldToRootCid(shas, sizes);
        (bytes32 sha, uint256 len, uint256 cum) = _referenceFold(shas, sizes);
        assertEq(gotSha, sha, "root digest");
        assertEq(gotLen, len, "root node length");
        assertEq(gotCum, cum, "root cumulative size");
        assertEq(gotCid, CID.encode(CID.CODEC_DAG_PB, sha), "root cid");
    }

    /// @dev One layer of the reference fold: digests, file sizes and cumulative DAG sizes, side by side.
    struct RefLayer {
        bytes32[] digests;
        uint256[] fileSizes;
        uint256[] cums;
    }

    /// @dev Balanced layers of at most 174 links, each node's data carrying the file size and every child's file size,
    ///      each link's Tsize the child's cumulative size; layer 1 links raw leaves, later layers dag-pb nodes.
    function _referenceFold(bytes32[] memory shas, uint256[] memory sizes)
        internal
        pure
        returns (bytes32 sha, uint256 len, uint256 cum)
    {
        RefLayer memory cur = RefLayer(shas, sizes, sizes); // a raw leaf's cumulative size is its size
        uint256 codec = CID.CODEC_RAW;
        while (cur.digests.length > 1) {
            (cur, len) = _referenceLayer(cur, codec);
            codec = CID.CODEC_DAG_PB;
        }
        return (cur.digests[0], len, cur.cums[0]);
    }

    function _referenceLayer(RefLayer memory cur, uint256 codec)
        private
        pure
        returns (RefLayer memory next, uint256 len)
    {
        uint256 m = (cur.digests.length + 173) / 174;
        next = RefLayer(new bytes32[](m), new uint256[](m), new uint256[](m));
        for (uint256 g; g < m; g++) {
            len = _referenceNode(next, g, cur, codec);
        }
    }

    /// @dev The dag-pb node over children `[174g, 174g + 174)` of `cur` becomes entry `g` of `next`; returns its length.
    function _referenceNode(RefLayer memory next, uint256 g, RefLayer memory cur, uint256 codec)
        private
        pure
        returns (uint256)
    {
        uint256 s = g * 174;
        uint256 e = s + 174 < cur.digests.length ? s + 174 : cur.digests.length;
        DagPB.Link[] memory links = new DagPB.Link[](e - s);
        uint256[] memory blocksizes = new uint256[](e - s);
        uint256 fileSize;
        uint256 childCum;
        for (uint256 i = s; i < e; i++) {
            links[i - s] = DagPB.Link({hash: CID.binary(codec, cur.digests[i]), name: "", tsize: cur.cums[i]});
            blocksizes[i - s] = cur.fileSizes[i];
            fileSize += cur.fileSizes[i];
            childCum += cur.cums[i];
        }
        bytes memory node = DagPB.encodeNode(links, UnixFS.fileDataWithBlocksizes(fileSize, blocksizes));
        next.digests[g] = sha256(node);
        next.fileSizes[g] = fileSize;
        next.cums[g] = node.length + childCum;
        return node.length;
    }

    /// @dev From the SDK and `ipfs-unixfs-importer` over `[block0, block1] * 87 + block0` of `runBytes`.
    string internal constant EXPECTED_ALTERNATING_175 = "bafybeicfyz34wqgujajp3zjrhno25owibye55ary6eqjcgnuonsbj3twfe";
    uint256 internal constant EXPECTED_ALTERNATING_175_TSIZE = 45_884_079;

    // ─────────────────────────── Helpers ───────────────────────────

    function _run(uint256 index, string memory expectedName, bool mixed) internal view {
        string memory base = string.concat(".[", vm.toString(index), "]");
        assertEq(vm.parseJsonString(fixtureJson, string.concat(base, ".name")), expectedName, "fixture order");
        uint256 leafCount = vm.parseJsonUint(fixtureJson, string.concat(base, ".leaf_count"));
        bytes32[] memory shas = new bytes32[](leafCount);
        uint256[] memory sizes = new uint256[](leafCount);
        uint256 uniform = mixed ? 0 : vm.parseJsonUint(fixtureJson, string.concat(base, ".leaf_size"));
        for (uint256 i = 0; i < leafCount; i++) {
            bytes memory cidBin =
                vm.parseJsonBytes(fixtureJson, string.concat(base, ".leaf_cid_bytes_hex.[", vm.toString(i), "]"));
            assertEq(cidBin.length, 36);
            assertEq(uint8(cidBin[1]), 0x55, "raw leaf");
            bytes32 sha;
            assembly {
                sha := mload(add(cidBin, 0x24))
            }
            shas[i] = sha;
            sizes[i] = mixed
                ? vm.parseJsonUint(fixtureJson, string.concat(base, ".leaf_sizes.[", vm.toString(i), "]"))
                : uniform;
        }
        (string memory gotCid, bytes32 gotSha, uint256 gotLen, uint256 gotCum) = harness.foldToRootCid(shas, sizes);
        assertEq(gotSha, bytes32(vm.parseJsonBytes(fixtureJson, string.concat(base, ".root_sha256_hex"))), "root sha256");
        assertEq(gotLen, vm.parseJsonUint(fixtureJson, string.concat(base, ".root_pbnode_len")), "root node length");
        assertEq(gotCid, vm.parseJsonString(fixtureJson, string.concat(base, ".root_cid")), "root CID");
        assertEq(gotCum, vm.parseJsonUint(fixtureJson, string.concat(base, ".root_cumulative_size")), "root cumulative");
    }
}

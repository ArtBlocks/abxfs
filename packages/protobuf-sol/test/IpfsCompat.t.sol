pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {Protobuf} from "../src/Protobuf.sol";
import {DagPB} from "../src/DagPB.sol";
import {UnixFS} from "../src/UnixFS.sol";
import {CID} from "../src/CID.sol";

/// @notice Parity tests against fixtures generated by @ipld/dag-pb + ipfs-unixfs + multiformats.
contract IpfsCompatTest is Test {
    function _sha256(bytes memory data) internal view returns (bytes32 h) {
        (bool ok, bytes memory ret) = address(0x02).staticcall(data);
        require(ok && ret.length == 32, "sha256");
        assembly {
            h := mload(add(ret, 32))
        }
    }

    /// @dev Compute a raw-codec CIDv1 for `data` and return the binary CID.
    function _rawCidBytes(bytes memory data) internal view returns (bytes memory) {
        bytes32 h = _sha256(data);
        return CID.binary(CID.CODEC_RAW, h);
    }

    /// @notice Raw-leaf CIDs produced by Solidity MUST equal fixture CIDs from multiformats/raw.
    function test_RawLeafCidsMatchFixtures() public view {
        _assertRawLeaf(bytes(""), "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku");
        _assertRawLeaf(bytes("hello\n"), "bafkreicysg23kiwv34eg2d7qweipxwosdo2py4ldv42nbauguluen5v6am");
        _assertRawLeaf(
            bytes("The quick brown fox jumps over the lazy dog\n"),
            "bafkreigahec7zwvss5ituyqozapni3fejxnwfva4xpmd5nffunmsxytkne"
        );
        _assertRawLeaf(hex"00", "bafkreidogqfzz75tpkmjzjke425xqcrmpcib2p5tg44hnbirumdbpl5adu");
        _assertRawLeaf(
            hex"deadbeefcafebabe0102",
            "bafkreidwejjn47uurfc5uc5hcwlqik4ux6td5ignhbhpczr7o5al6bhrtu"
        );
    }

    function _assertRawLeaf(bytes memory data, string memory expected) internal view {
        bytes32 h = _sha256(data);
        assertEq(CID.encode(CID.CODEC_RAW, h), expected);
    }

    /// @notice PBNode bytes for a two-file directory must match fixture bytes exactly.
    function test_TwoFileDirectory_PBNodeBytes() public view {
        bytes memory aBytes = bytes("alpha");
        bytes memory bBytes = bytes("beta");

        DagPB.Link[] memory links = new DagPB.Link[](2);
        links[0] = DagPB.Link({hash: _rawCidBytes(aBytes), name: "a.txt", tsize: aBytes.length});
        links[1] = DagPB.Link({hash: _rawCidBytes(bBytes), name: "b.txt", tsize: bBytes.length});

        bytes memory node = DagPB.encodeNode(links, UnixFS.directoryData());

        bytes memory expected =
            hex"122f0a24015512208ed3f6ad685b959ead7022518e1af76cd816f8e8ec7ccdda1ed4018e8f2223f81205612e7478741805122f0a2401551220f44e64e75f3948e9f73f8dfa94721c4ce8cbb4f265c4790c702b2d41cfbf27531205622e74787418040a020801";
        assertEq(node, expected);

        bytes32 sha = _sha256(node);
        assertEq(sha, bytes32(0x3713b02b19e84cfe3795aa63b1e428291c27192d34702809b1c762dd4dcc3ad8));
        assertEq(CID.encode(CID.CODEC_DAG_PB, sha), "bafybeibxcoycwgpijt7dpfnkmoy6ikbjdqtrsljuoauatmohmlou3tb23a");
    }

    /// @notice Directory with dotted names (\u00a7 "Valid names include dots in names").
    function test_DottedNameDirectory() public view {
        bytes memory gi = bytes("node_modules\n");
        bytes memory rd = bytes("# Demo\n");
        bytes memory pj = bytes('{"name":"demo"}');

        DagPB.Link[] memory links = new DagPB.Link[](3);
        links[0] = DagPB.Link({hash: _rawCidBytes(gi), name: ".gitignore", tsize: gi.length});
        links[1] = DagPB.Link({hash: _rawCidBytes(rd), name: "README.md", tsize: rd.length});
        links[2] = DagPB.Link({hash: _rawCidBytes(pj), name: "package.json", tsize: pj.length});

        bytes memory node = DagPB.encodeNode(links, UnixFS.directoryData());
        bytes32 sha = _sha256(node);
        assertEq(CID.encode(CID.CODEC_DAG_PB, sha), "bafybeigyrfeofgyduhdwhvqjn3rj5tqqpevrelfghfp7p4v7vhgb6thyzq");
    }

    /// @notice Nested directory: outer contains one subdirectory link.
    function test_NestedDirectory() public view {
        bytes memory leafBytes = bytes("leaf");

        // Inner dir: { "l.txt" -> raw leaf }
        DagPB.Link[] memory innerLinks = new DagPB.Link[](1);
        innerLinks[0] =
            DagPB.Link({hash: _rawCidBytes(leafBytes), name: "l.txt", tsize: leafBytes.length});
        bytes memory innerNode = DagPB.encodeNode(innerLinks, UnixFS.directoryData());
        bytes32 innerSha = _sha256(innerNode);
        bytes memory innerCidBytes = CID.binary(CID.CODEC_DAG_PB, innerSha);
        assertEq(CID.encode(CID.CODEC_DAG_PB, innerSha), "bafybeiddvzalyat4hfxk4gmphkncxiiy4zjmassy6wcq3wlds32qddglfe");

        // Outer dir: { "inner" -> inner cid (dag-pb), tsize = inner serialized length }
        DagPB.Link[] memory outerLinks = new DagPB.Link[](1);
        outerLinks[0] = DagPB.Link({hash: innerCidBytes, name: "inner", tsize: innerNode.length});
        bytes memory outerNode = DagPB.encodeNode(outerLinks, UnixFS.directoryData());
        bytes32 outerSha = _sha256(outerNode);
        assertEq(CID.encode(CID.CODEC_DAG_PB, outerSha), "bafybeidv7uw7gxtnjbmnelz64ifzvkin26lt6z4n7woe7jgi42vgweevdy");
    }
}
